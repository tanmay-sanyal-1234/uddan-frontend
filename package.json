    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "jquery": "^3.7.1",
    "moment": "^2.30.1",
    "owl.carousel": "^2.3.4",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.0",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.1",
