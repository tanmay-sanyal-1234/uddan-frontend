{
  "name": "uddan-scholars",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pm2:start": "pm2 start 'serve -s dist -l 5000' --name uddan-frontend",
    "postbuild": "react-snap"
